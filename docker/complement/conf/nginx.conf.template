worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;

    upstream neutrino {
        server 127.0.0.1:18008;
    }

    # Plain HTTP for client-server traffic.
    server {
        listen 8008 default_server;
        listen [::]:8008 default_server;
        server_name ${SERVER_NAME};

        client_max_body_size 50M;

        location / {
            proxy_pass http://neutrino;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }
    }

    # TLS for federation traffic. Federation is out of scope for now, but
    # complement still expects 8448 to be reachable.
    server {
        listen 8448 ssl default_server;
        listen [::]:8448 ssl default_server;
        server_name ${SERVER_NAME};

        ssl_certificate /etc/neutrino/server.crt;
        ssl_certificate_key /etc/neutrino/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        client_max_body_size 50M;

        location / {
            proxy_pass http://neutrino;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }
    }
}
